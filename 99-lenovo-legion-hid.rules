# Lenovo Legion Accessory Central v2.0.9.10231 — Linux udev permissions rule
# Covers all 10 supported Lenovo Legion Mice & Keyboards:
#   M300 (60e4), M300s (6132, 6155), M500 (60d4), M600 (60e5, 60e6),
#   M600s (6133, 6135, 6140), M600s Qi (6136, 6138, 6141),
#   K300 (60f0), K310 (6199), K310 AI (6205), K500 (60d5)
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="17ef", ATTRS{idProduct}=="60e4", MODE="0666", TAG+="uaccess"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="17ef", ATTRS{idProduct}=="6132", MODE="0666", TAG+="uaccess"
